# A generated secret for Payload
PAYLOAD_SECRET=

# Public app URL, without a trailing slash (not a secret).
# Payload uses it for absolute upload URLs; Next allows this host for image optimization.
# Absolute URLs avoid OpenNext looking for Payload API images in static assets.
# Set before building/deploying: NEXT_PUBLIC_ values are embedded in the build.
# Use http://localhost:3000 locally, or https://exploring-joara.evanhkim09.workers.dev for deployment.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
